---
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Experience from "../components/Experience.astro";
import Blogs from "../components/Blogs.astro";
import Projects from "../components/Projects.astro";
import Contact from "../components/Contact.astro";
import themeData from "../data/theme.json";
import "../styles/global.css";
---

<html lang="en" class="dark">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Gaurav Doliya | Visual Arts & Motion Design Educator</title>
		<meta
			name="description"
			content="Portfolio of Gaurav Doliya — Motion Design & Post-Production Educator with 7 years of studio-style teaching. Open to IB Visual Arts, Design, and Media roles."
		/>

		<!-- Modern Google Fonts: Anton (for headings) & Plus Jakarta Sans -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>

		<!-- Dynamic theme colors -->
		<style define:vars={{
			primaryAccent: themeData.primaryColor || '#7C3AED',
			heroAccent: themeData.heroColor || '#de4528',
			heroGray: themeData.grayColor || '#58687e'
		}}>
			:root {
				--accent: var(--primaryAccent, #7C3AED);
				--hero-accent: var(--heroAccent, #de4528);
				--hero-gray: var(--heroGray, #58687e);
			}
		</style>

		<!-- Prevent theme flash script (Default: ALWAYS Dark Theme) -->
		<script is:inline>
			(() => {
				function applyCustomTheme(data) {
					if (!data) return;
					let hero = data.heroColor;
					if (!hero || hero.toLowerCase() === '#7c3aed') {
						hero = '#de4528';
					}
					const primary = data.primaryColor || '#7C3AED';
					document.documentElement.style.setProperty("--hero-accent", hero);
					document.documentElement.style.setProperty("--accent", primary);
					if (data.grayColor) {
						document.documentElement.style.setProperty("--hero-gray", data.grayColor);
					}
				}

				// Apply custom saved theme colors if present
				try {
					const savedTheme = localStorage.getItem("portfolio_theme");
					if (savedTheme) {
						const parsed = JSON.parse(savedTheme);
						if (parsed.heroColor && parsed.heroColor.toLowerCase() === '#7c3aed') {
							parsed.heroColor = '#de4528';
							localStorage.setItem("portfolio_theme", JSON.stringify(parsed));
						}
						applyCustomTheme(parsed);
					}
				} catch (_) {}

				// Live synchronization when theme is updated in admin dashboard
				if (typeof window !== "undefined") {
					window.addEventListener("storage", (e) => {
						if (e.key === "portfolio_theme" && e.newValue) {
							try { applyCustomTheme(JSON.parse(e.newValue)); } catch (_) {}
						}
					});

					// Fetch latest theme configuration from backend API
					try {
						fetch("/api/theme")
							.then((res) => res.json())
							.then((data) => {
								if (data?.success && data?.data) {
									applyCustomTheme(data.data);
								}
							})
							.catch(() => {});
					} catch (_) {}
				}

				// Clear any stale light mode so default is always dark
				if (
					typeof localStorage !== "undefined" &&
					localStorage.getItem("theme") === "light"
				) {
					localStorage.removeItem("theme");
				}
				if (
					typeof sessionStorage !== "undefined" &&
					sessionStorage.getItem("theme") === "light"
				) {
					sessionStorage.removeItem("theme");
				}

				const isDark = (() => {
					if (
						typeof sessionStorage !== "undefined" &&
						sessionStorage.getItem("theme")
					) {
						return sessionStorage.getItem("theme") === "dark";
					}
					if (
						typeof localStorage !== "undefined" &&
						localStorage.getItem("theme")
					)	 {
						return localStorage.getItem("theme") === "dark";
					}
					return true; // Default to dark theme
				})();

				document.documentElement.classList.toggle("dark", isDark);
			})();
		</script>
	</head>
	<body
		class="min-h-screen bg-[#F5F5F5] text-zinc-900 dark:bg-black dark:text-zinc-100 selection:bg-accent selection:text-white transition-colors duration-200"
	>
		<Navbar />
		<main>
			<Hero />
			<Experience />
			<Blogs />
			<Projects />
			<Contact />
		</main>
	</body>
</html>
