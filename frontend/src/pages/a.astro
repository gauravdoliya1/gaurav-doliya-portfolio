---
import redirectConfig from "../data/redirectConfig.json";
import "../styles/global.css";

// 1. Resolve configuration from Environment Variables (Priority) or JSON file (Fallback)
const envActive =
  import.meta.env.REDIRECT_A_ACTIVE ??
  import.meta.env.PUBLIC_REDIRECT_A_ACTIVE ??
  process.env.REDIRECT_A_ACTIVE;

const envTarget =
  import.meta.env.REDIRECT_A_TARGET ??
  import.meta.env.PUBLIC_REDIRECT_A_TARGET ??
  process.env.REDIRECT_A_TARGET;

// Parse boolean state
const isActive =
  envActive !== undefined
    ? String(envActive).trim().toLowerCase() === "true" || String(envActive).trim() === "1"
    : Boolean(redirectConfig.isActive);

// Target URL
const targetUrl =
  envTarget && String(envTarget).trim() !== ""
    ? String(envTarget).trim()
    : String(redirectConfig.targetUrl || "").trim();

const shouldRedirect = isActive && Boolean(targetUrl);

// 2. Server-side redirect (if SSR mode is enabled in Astro)
if (shouldRedirect && typeof Astro.redirect === "function") {
  return Astro.redirect(targetUrl, 307);
}

// Social media links configuration for the Coming Soon fallback
const socials = [
  {
    name: "Instagram",
    href: "https://instagram.com/gauravdoliya",
    color: "hover:text-[#E4405F] hover:border-[#E4405F]/40 hover:bg-[#E4405F]/10",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>`
