---
const pageTitle = "Portfolio Controls | Gaurav Doliya";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>

    <!-- Admin Route Protection -->
    <script is:inline>
      if (typeof sessionStorage !== "undefined" && sessionStorage.getItem("admin_auth") !== "true") {
        window.location.replace("/admin");
      }
    </script>
  </head>

  <body>
    <main class="dashboard">

      <!-- Header -->
      <header class="topbar">
        <div>
          <h1>Portfolio Controls</h1>
          <p>Manage your portfolio website from one place.</p>
        </div>

        <div class="topbar-actions">
          <a href="/" target="_blank" rel="noopener noreferrer" class="preview-btn">Live Site ↗</a>
          <a href="/admin" class="logout" id="logoutBtn">Logout</a>
        </div>
      </header>

      <!-- Welcome -->
      <section class="welcome">
        <div>
          <h2>Welcome to Admin Panel</h2>
          <p>Choose what you want to manage.</p>
        </div>

        <span class="status">System Active</span>
      </section>

      <!-- Manage Website -->
      <section class="controls">
        <h2>Manage Website</h2>

        <div class="control-grid">

          <button class="control-card" data-modal="contact">
            <span class="number">01</span>
            <h3>Contact Details</h3>
            <p>Update email and WhatsApp phone number.</p>
            <span class="action">Manage Details →</span>
          </button>

          <button class="control-card" data-modal="resume">
            <span class="number">02</span>
            <h3>Resume</h3>
            <p>Upload or replace your portfolio resume.</p>
            <span class="action">Manage Resume →</span>
          </button>

          <button class="control-card" data-modal="theme">
            <span class="number">03</span>
            <h3>Website Colors</h3>
            <p>Change primary accent and homepage wave ribbon colors.</p>
            <span class="action">Customize Colors →</span>
          </button>

        </div>
      </section>

      <!-- Quick Information -->
      <section class="info">
        <h2>Quick Information</h2>
        <p>
          Updates made in this control panel synchronize directly across the live website and storage.
        </p>
      </section>

      <footer>
        Portfolio Admin Panel · Gaurav Doliya
      </footer>

    </main>

    <!-- Modal -->
    <div class="modal-overlay" id="adminModal">
      <div class="modal-box">

        <div class="modal-header">
          <h2 id="modalTitle">Settings</h2>
          <button type="button" id="closeModal" aria-label="Close">×</button>
        </div>

        <div id="modalContent"></div>

      </div>
    </div>

  </body>
</html>

<script>
  const modal = document.querySelector("#adminModal");
  const modalTitle = document.querySelector("#modalTitle");
  const modalContent = document.querySelector("#modalContent");
  const closeModal = document.querySelector("#closeModal");

  const modalData = {
    contact: {
      title: "Contact Details",
      content: `
        <form id="contactForm">

          <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" placeholder="gauravdoliya.fxwork@gmail.com" required>
            <span class="input-hint">Direct email contact displayed on navbar and footer.</span>
          </div>

          <div class="form-group">
            <label for="phone">WhatsApp / Phone Number</label>
            <input type="tel" id="phone" placeholder="+91 83830 43341" required>
            <span class="input-hint">International format for click-to-chat messaging.</span>
          </div>

          <button type="submit" class="save-button">Save Changes</button>

          <p class="form-message" id="contactMessage"></p>

        </form>
      `
    },

    resume: {
      title: "Resume Management",
      content: `
        <div class="current-resume">
          <div class="file-icon">PDF</div>

          <div class="resume-meta">
            <h3>Gaurav Doliya Resume</h3>
            <p id="resumeCurrentName">CV_Gaurav_Doliya.pdf</p>
            <a href="/CV_Gaurav_Doliya.pdf" target="_blank" rel="noopener noreferrer">
              View Current Resume ↗
            </a>
          </div>
        </div>

        <form id="resumeForm">

          <div class="form-group">
            <label for="resumeFile">Upload New Resume (PDF)</label>
            <div class="upload-box">
              <input
                type="file"
                id="resumeFile"
                accept=".pdf,application/pdf"
                required
              />
              <p>Only PDF format is accepted. Maximum size 15MB.</p>
            </div>
          </div>

          <button type="submit" class="save-button">
            Update Resume
          </button>

          <p class="form-message" id="resumeMessage"></p>

        </form>
      `
    },

    theme: {
      title: "Website Colors",
      content: `
        <form id="themeForm">

          <div class="form-group">
            <label for="primaryColor">Primary Color</label>
            <div class="color-input">
              <input type="color" id="primaryColor" value="#de4528">
              <div class="color-meta">
                <span class="color-hex" id="primaryHexVal">#de4528</span>
                <span class="color-desc">Signature accent on buttons and highlights</span>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label for="grayColor">Homepage Wave Ribbons Color</label>
            <div class="color-input">
              <input type="color" id="grayColor" value="#58687e">
              <div class="color-meta">
                <span class="color-hex" id="grayHexVal">#58687e</span>
                <span class="color-desc">Hero fluid background wave ribbons</span>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label for="backgroundColor">Background Color</label>
            <div class="color-input">
              <input type="color" id="backgroundColor" value="#0c0706">
              <div class="color-meta">
                <span class="color-hex" id="bgHexVal">#0c0706</span>
                <span class="color-desc">Website dark theme background canvas</span>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label for="textColor">Text Color</label>
            <div class="color-input">
              <input type="color" id="textColor" value="#ffffff">
              <div class="color-meta">
                <span class="color-hex" id="textHexVal">#ffffff</span>
                <span class="color-desc">Primary typography text color</span>
              </div>
            </div>
          </div>

          <button type="submit" class="save-button">
            Save Colors
          </button>

          <p class="form-message" id="themeMessage"></p>

        </form>
      `
    }
  };

  let latestResumeUrl = "/CV_Gaurav_Doliya.pdf";
  let latestResumeName = "CV_Gaurav_Doliya.pdf";

  // Open modal
  document.querySelectorAll("[data-modal]").forEach((card) => {
    card.addEventListener("click", () => {
      const type = card.getAttribute("data-modal");

      if (!type || !modal || !modalTitle || !modalContent) return;

      const data = modalData[type as keyof typeof modalData];

      if (!data) return;

      modalTitle.textContent = data.title;
      modalContent.innerHTML = data.content;

      if (type === "resume") {
        const link = modalContent.querySelector(".current-resume a");
        const name = modalContent.querySelector("#resumeCurrentName");
        if (link && latestResumeUrl) {
          link.setAttribute("href", latestResumeUrl);
        }
        if (name && latestResumeName) {
          name.textContent = latestResumeName;
        }
      }

      modal.classList.add("active");
      document.body.classList.add("modal-open");

      attachFormEvents();
    });
  });

  // Close modal
  function hideModal() {
    modal?.classList.remove("active");
    document.body.classList.remove("modal-open");
  }

  closeModal?.addEventListener("click", hideModal);

  modal?.addEventListener("click", (event) => {
    if (event.target === modal) {
      hideModal();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      hideModal();
    }
  });

  // Form events
  function attachFormEvents() {
    const apiUrl = import.meta.env.PUBLIC_API_URL || (typeof window !== "undefined" && window.location.hostname !== "localhost" ? window.location.origin : "http://localhost:3000");

    // 1. Contact form
    const contactForm = document.querySelector("#contactForm");
    if (contactForm) {
      const emailInput = contactForm.querySelector("#email") as HTMLInputElement | null;
      const phoneInput = contactForm.querySelector("#phone") as HTMLInputElement | null;
      const message = contactForm.querySelector("#contactMessage") as HTMLElement | null;

      fetch(`${apiUrl}/api/contact`)
        .then((res) => res.json())
        .then((data) => {
          if (data?.success && data?.data) {
            if (emailInput && !emailInput.value) emailInput.value = data.data.email || "";
            if (phoneInput && !phoneInput.value) phoneInput.value = data.data.phone || data.data.whatsapp || "";
          }
        })
        .catch(() => {
          if (emailInput && !emailInput.value) emailInput.value = "gauravdoliya.fxwork@gmail.com";
          if (phoneInput && !phoneInput.value) phoneInput.value = "+91 83830 43341";
        });

      contactForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        const submitBtn = contactForm.querySelector("button[type='submit']") as HTMLButtonElement | null;
        const email = emailInput?.value.trim();
        const phone = phoneInput?.value.trim();

        if (!email || !phone) {
          if (message) {
            message.textContent = "Please fill in both Email and Phone/WhatsApp.";
            message.style.color = "#f87171";
          }
          return;
        }

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = "Saving...";
          submitBtn.style.opacity = "0.7";
        }

        if (message) {
          message.textContent = "Saving contact details, please wait...";
          message.style.color = "#de4528";
        }

        try {
          const res = await fetch(`${apiUrl}/api/contact`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              email,
              phone,
              whatsapp: phone.replace(/[^0-9]/g, "")
            })
          });

          const data = await res.json().catch(() => null);
          if (res.ok && data?.success) {
            if (message) {
              message.textContent = data.message || "Contact details updated successfully!";
              message.style.color = "#4ade80";
            }
          } else {
            if (message) {
              message.textContent = data?.message || "Failed to update contact details.";
              message.style.color = "#f87171";
            }
          }
        } catch (err) {
          if (message) {
            message.textContent = "Network error: Unable to connect to backend.";
            message.style.color = "#f87171";
          }
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = "Save Changes";
            submitBtn.style.opacity = "1";
          }
        }
      });
    }

    // 2. Resume form
    const resumeForm = document.querySelector("#resumeForm");
    if (resumeForm) {
      resumeForm.addEventListener("submit", async (event) => {
        event.preventDefault();

        const fileInput = document.querySelector("#resumeFile") as HTMLInputElement | null;
        const message = document.querySelector("#resumeMessage") as HTMLElement | null;
        const submitButton = resumeForm.querySelector("button[type='submit']") as HTMLButtonElement | null;
        const currentResumeLink = document.querySelector(".current-resume a") as HTMLAnchorElement | null;
        const currentResumeName = document.querySelector("#resumeCurrentName") as HTMLElement | null;

        const file = fileInput?.files?.[0];

        if (!file || !message) return;

        const isPdf = file.type === "application/pdf" || file.name.toLowerCase().endsWith(".pdf");
        if (!isPdf) {
          message.textContent = "Please select a valid PDF file.";
          message.style.color = "#f87171";
          return;
        }

        const originalButtonText = submitButton ? submitButton.textContent : "Update Resume";
        if (submitButton) {
          submitButton.disabled = true;
          submitButton.textContent = "Uploading...";
          submitButton.style.opacity = "0.7";
          submitButton.style.cursor = "not-allowed";
        }

        message.textContent = "Uploading resume, please wait...";
        message.style.color = "#de4528";

        try {
          const formData = new FormData();
          formData.append("resume", file);

          const response = await fetch(`${apiUrl}/api/resume/upload`, {
            method: "POST",
            body: formData
          });

          const data = await response.json().catch(() => null);

          if (response.ok && data?.success) {
            message.textContent = data.message || "Resume uploaded successfully!";
            message.style.color = "#4ade80";

            const uploadedUrl = `${apiUrl}/uploads/resume.pdf`;
            latestResumeUrl = uploadedUrl;
            latestResumeName = file.name;

            if (currentResumeLink) {
              currentResumeLink.setAttribute("href", uploadedUrl);
              currentResumeLink.textContent = "View Current Resume ↗";
            }
            if (currentResumeName) {
              currentResumeName.textContent = file.name;
            }

            if (fileInput) {
              fileInput.value = "";
            }
          } else {
            message.textContent = data?.message || "Failed to upload resume. Please try again.";
            message.style.color = "#f87171";
          }
        } catch (error) {
          console.error("Resume upload error:", error);
          message.textContent = "Network error: Unable to connect to backend server. Make sure backend is running.";
          message.style.color = "#f87171";
        } finally {
          if (submitButton) {
            submitButton.disabled = false;
            submitButton.textContent = originalButtonText || "Update Resume";
            submitButton.style.opacity = "1";
            submitButton.style.cursor = "pointer";
          }
        }
      });
    }

    // 3. Theme form
    const themeForm = document.querySelector("#themeForm");
    if (themeForm) {
      const primaryInput = themeForm.querySelector("#primaryColor") as HTMLInputElement | null;
      const primaryHex = themeForm.querySelector("#primaryHexVal") as HTMLElement | null;

      const grayInput = themeForm.querySelector("#grayColor") as HTMLInputElement | null;
      const grayHex = themeForm.querySelector("#grayHexVal") as HTMLElement | null;

      const bgInput = themeForm.querySelector("#backgroundColor") as HTMLInputElement | null;
      const bgHex = themeForm.querySelector("#bgHexVal") as HTMLElement | null;

      const textInput = themeForm.querySelector("#textColor") as HTMLInputElement | null;
      const textHex = themeForm.querySelector("#textHexVal") as HTMLElement | null;

      const message = themeForm.querySelector("#themeMessage") as HTMLElement | null;

      function updateHexDisplays() {
        if (primaryHex && primaryInput) primaryHex.textContent = primaryInput.value.toUpperCase();
        if (grayHex && grayInput) grayHex.textContent = grayInput.value.toUpperCase();
        if (bgHex && bgInput) bgHex.textContent = bgInput.value.toUpperCase();
        if (textHex && textInput) textHex.textContent = textInput.value.toUpperCase();
      }

      primaryInput?.addEventListener("input", updateHexDisplays);
      grayInput?.addEventListener("input", updateHexDisplays);
      bgInput?.addEventListener("input", updateHexDisplays);
      textInput?.addEventListener("input", updateHexDisplays);

      fetch(`${apiUrl}/api/theme`)
        .then((res) => res.json())
        .then((data) => {
          if (data?.success && data?.data) {
            if (primaryInput) primaryInput.value = data.data.primaryColor || "#de4528";
            if (grayInput) grayInput.value = data.data.grayColor || "#58687e";
            if (bgInput) bgInput.value = data.data.backgroundColor || "#0c0706";
            if (textInput) textInput.value = data.data.textColor || "#ffffff";
            updateHexDisplays();
          }
        })
        .catch(() => {
          try {
            const saved = localStorage.getItem("portfolio_theme");
            if (saved) {
              const parsed = JSON.parse(saved);
              if (parsed.primaryColor && primaryInput) primaryInput.value = parsed.primaryColor;
              if (parsed.grayColor && grayInput) grayInput.value = parsed.grayColor;
              if (parsed.backgroundColor && bgInput) bgInput.value = parsed.backgroundColor;
              if (parsed.textColor && textInput) textInput.value = parsed.textColor;
              updateHexDisplays();
            }
          } catch (_) {}
        });

      themeForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        const submitBtn = themeForm.querySelector("button[type='submit']") as HTMLButtonElement | null;
        const primaryColor = primaryInput?.value || "#de4528";
        const grayColor = grayInput?.value || "#58687e";
        const backgroundColor = bgInput?.value || "#0c0706";
        const textColor = textInput?.value || "#ffffff";

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = "Saving...";
          submitBtn.style.opacity = "0.7";
        }

        if (message) {
          message.textContent = "Saving colors, please wait...";
          message.style.color = "#de4528";
        }

        try {
          const res = await fetch(`${apiUrl}/api/theme`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ primaryColor, grayColor, backgroundColor, textColor })
          });

          const data = await res.json().catch(() => null);

          try {
            localStorage.setItem(
              "portfolio_theme",
              JSON.stringify({ primaryColor, grayColor, backgroundColor, textColor })
            );
            document.documentElement.style.setProperty("--accent", primaryColor);
            document.documentElement.style.setProperty("--hero-gray", grayColor);
          } catch (_) {}

          if (res.ok && data?.success) {
            if (message) {
              message.textContent = data.message || "Website colors updated successfully!";
              message.style.color = "#4ade80";
            }
          } else {
            if (message) {
              message.textContent = data?.message || "Failed to update colors.";
              message.style.color = "#f87171";
            }
          }
        } catch (err) {
          if (message) {
            message.textContent = "Network error: Unable to connect to backend.";
            message.style.color = "#f87171";
          }
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = "Save Colors";
            submitBtn.style.opacity = "1";
          }
        }
      });
    }
  }

  // Logout
  const logoutBtn = document.querySelector("#logoutBtn");
  logoutBtn?.addEventListener("click", () => {
    sessionStorage.removeItem("admin_auth");
    sessionStorage.removeItem("admin_user");
  });
</script>

<style is:global>
  * {
    box-sizing: border-box;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: #0c0706;
    color: #fff;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  body.modal-open {
    overflow: hidden;
  }

  .dashboard {
    width: min(100% - 40px, 1100px);
    margin: 0 auto;
    padding: 45px 0;
  }

  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 35px;
    border-bottom: 1px solid #201c24;
    padding-bottom: 24px;
  }

  .topbar-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .preview-btn {
    color: #a1a1aa;
    text-decoration: none;
    border: 1px solid #27272a;
    background: #18181b;
    padding: 9px 16px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    transition: all 0.2s;
  }

  .preview-btn:hover {
    color: #ffffff;
    border-color: #3f3f46;
    background: #27272a;
  }

  h1, h2, h3, p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 8px;
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.5px;
    color: #ffffff;
  }

  .topbar p,
  .welcome p {
    color: #8e8895;
    font-size: 14px;
    margin-bottom: 0;
  }

  .logout {
    color: #de4528;
    text-decoration: none;
    border: 1px solid rgba(222, 69, 40, 0.35);
    background: rgba(222, 69, 40, 0.1);
    padding: 9px 18px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all 0.2s;
  }

  .logout:hover {
    background: #de4528;
    color: #ffffff;
  }

  .welcome {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 26px 30px;
    background: #141012;
    border: 1px solid #261f22;
    border-radius: 14px;
    margin-bottom: 38px;
  }

  .welcome h2 {
    margin-bottom: 6px;
    font-size: 20px;
    font-weight: 700;
  }

  .status {
    color: #4ade80;
    background: rgba(74, 222, 128, 0.1);
    border: 1px solid rgba(74, 222, 128, 0.25);
    padding: 8px 14px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    white-space: nowrap;
  }

  .controls h2,
  .info h2 {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 20px;
    color: #f4f4f5;
  }

  .control-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .control-card {
    display: block;
    width: 100%;
    padding: 26px;
    border: 1px solid #221c20;
    border-radius: 14px;
    background: #130f11;
    color: white;
    text-align: left;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .control-card:hover {
    border-color: rgba(222, 69, 40, 0.6);
    background: #171214;
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
  }

  .number {
    color: #de4528;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
  }

  .control-card h3 {
    margin: 22px 0 10px;
    font-size: 18px;
    font-weight: 700;
  }

  .control-card p {
    color: #8e8895;
    font-size: 13px;
    line-height: 1.6;
    min-height: 44px;
  }

  .action {
    display: inline-block;
    margin-top: 14px;
    color: #de4528;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .info {
    margin-top: 35px;
    padding: 24px;
    border: 1px solid #221c20;
    border-radius: 12px;
    background: #100c0e;
  }

  .info p {
    color: #8e8895;
    font-size: 13px;
    line-height: 1.6;
    margin-bottom: 0;
  }

  footer {
    margin-top: 45px;
    color: #555;
    font-size: 12px;
    text-align: center;
  }

  /* Modal Overlay & Box */

  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
    justify-content: center;
    align-items: center;
    padding: 20px;
    background: rgba(0, 0, 0, 0.82);
    backdrop-filter: blur(8px);
  }

  .modal-overlay.active {
    display: flex;
  }

  .modal-box {
    width: 100%;
    max-width: 500px;
    max-height: 88vh;
    overflow-y: auto;
    padding: 30px;
    background: #141012;
    border: 1px solid #2a2226;
    border-radius: 16px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
    animation: modalOpen 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes modalOpen {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(8px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid #251e22;
  }

  .modal-header h2 {
    margin: 0;
    font-size: 20px;
